# Missing People Tracker - Environment Configuration
# Copy this file to .env for local cloud development

# Gemini AI API Key (Optional)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="MY_APP_URL"

# Firebase Cloud Firestore & Authentication Configuration (Optional - App runs with Standalone Persistence by default)
VITE_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VITE_FIREBASE_AUTH_DOMAIN="my-missing-tracker.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="my-missing-tracker"
VITE_FIREBASE_STORAGE_BUCKET="my-missing-tracker.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"
VITE_FIREBASE_DATABASE_ID="(default)"
