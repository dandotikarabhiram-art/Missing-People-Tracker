{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered user account with role permissions and contact details.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 120 },
        "displayName": { "type": "string", "maxLength": 80 },
        "role": { "type": "string", "enum": ["public", "reporter", "investigator", "admin"] },
        "phoneNumber": { "type": "string", "maxLength": 40 },
        "badgeNumber": { "type": "string", "maxLength": 60 },
        "department": { "type": "string", "maxLength": 120 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "displayName", "role"]
    },
    "MissingPersonReport": {
      "title": "MissingPersonReport",
      "description": "Missing person case details, circumstances, and verification lifecycle.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "referenceNumber": { "type": "string", "maxLength": 30 },
        "ownerId": { "type": "string", "maxLength": 128 },
        "ownerName": { "type": "string", "maxLength": 80 },
        "fullName": { "type": "string", "maxLength": 120 },
        "age": { "type": "number" },
        "gender": { "type": "string" },
        "height": { "type": "string", "maxLength": 40 },
        "hairColor": { "type": "string", "maxLength": 40 },
        "eyeColor": { "type": "string", "maxLength": 40 },
        "clothingLastSeen": { "type": "string", "maxLength": 500 },
        "identifyingFeatures": { "type": "string", "maxLength": 500 },
        "photoUrl": { "type": "string", "maxLength": 2048 },
        "dateLastSeen": { "type": "string", "maxLength": 20 },
        "lastSeenCity": { "type": "string", "maxLength": 80 },
        "lastSeenState": { "type": "string", "maxLength": 80 },
        "circumstances": { "type": "string", "maxLength": 4000 },
        "status": {
          "type": "string",
          "enum": [
            "Pending Review",
            "Verified / Active",
            "Under Investigation",
            "New Lead Received",
            "Located — Awaiting Confirmation",
            "Resolved / Closed",
            "Rejected",
            "Withdrawn"
          ]
        },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High", "Critical / Endangered"] },
        "visibility": { "type": "string", "enum": ["private", "investigators_only", "public"] },
        "assignedInvestigatorId": { "type": "string", "maxLength": 128 }
      },
      "required": ["id", "referenceNumber", "ownerId", "fullName", "age", "dateLastSeen", "lastSeenCity", "status"]
    },
    "Sighting": {
      "title": "Sighting",
      "description": "Citizen observation linked to an active missing person case.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sightingReference": { "type": "string", "maxLength": 30 },
        "caseId": { "type": "string", "maxLength": 128 },
        "caseReferenceNumber": { "type": "string", "maxLength": 30 },
        "dateObserved": { "type": "string", "maxLength": 20 },
        "locationDescription": { "type": "string", "maxLength": 250 },
        "city": { "type": "string", "maxLength": 80 },
        "state": { "type": "string", "maxLength": 80 },
        "observationDetails": { "type": "string", "maxLength": 3000 },
        "witnessName": { "type": "string", "maxLength": 80 },
        "witnessContact": { "type": "string", "maxLength": 120 },
        "status": {
          "type": "string",
          "enum": ["New", "Under Investigation", "Verified Relevant", "Inconclusive", "Dismissed"]
        }
      },
      "required": ["id", "sightingReference", "caseId", "dateObserved", "locationDescription", "city", "state", "observationDetails", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and security credentials"
    },
    "/missingPersons/{caseId}": {
      "schema": "MissingPersonReport",
      "description": "Registered and verified missing person cases"
    },
    "/sightings/{sightingId}": {
      "schema": "Sighting",
      "description": "Community sighting tips and lead verification"
    }
  }
}
